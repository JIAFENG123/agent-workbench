# --- Core ---
ENVIRONMENT=dev
DEBUG=false
LOG_LEVEL=INFO

# --- Database (Neon free tier: postgresql+asyncpg://USER:PASS@HOST/DB?ssl=require) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/workbench

# --- Auth ---
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRE_MINUTES=10080

# --- CORS (comma separated) ---
CORS_ORIGINS=http://localhost:3000

# --- NVIDIA NIM (https://build.nvidia.com) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b

# nemotron-3-embed-1b outputs 2048-dim vectors (verified against the model card) and
# REQUIRES input_type=query|passage — mixing them up silently wrecks retrieval accuracy.
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_DIM=2048
# END discards overflowing tokens; with NONE the API returns 422 instead.
EMBEDDING_TRUNCATE=END

# Reranking is on a different host and takes the model id in the path (dots -> underscores):
#   https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-vl-1b-v2/reranking
RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
RERANK_BASE_URL=https://ai.api.nvidia.com/v1/retrieval
# Set to override the whole URL (e.g. a self-hosted NIM at http://localhost:8000/v1/ranking).
RERANK_URL=
# Reuses NVIDIA_API_KEY when empty.
RERANK_API_KEY=
RERANK_ENABLED=true

# --- Optional fallback provider (any OpenAI-compatible endpoint) ---
FALLBACK_ENABLED=false
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=

# --- Cost control ---
INPUT_PRICE_PER_1M_TOKENS=0
OUTPUT_PRICE_PER_1M_TOKENS=0
DAILY_BUDGET_USD=2.0

# --- Upload limits ---
# Guards the raw read into memory. Binary formats extract to far less text than they weigh,
# so this is a weak proxy for cost — raise it for bigger PDFs.
MAX_UPLOAD_BYTES=26214400
# Sanity ceiling, not a budget: bounds row count, HNSW size and embedding calls.
MAX_CHUNKS_PER_DOCUMENT=10000

# --- Optional Redis (Render Key Value / Upstash) for rate limiting ---
REDIS_URL=

# --- Optional Langfuse tracing ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
